# The single public entry point: serves the demo console and routes each
# service under its own path prefix. The services themselves stay private.
# DOMAIN defaults to :80 in compose (plain http, local). Set DOMAIN to a real
# hostname -> Caddy obtains and renews TLS certificates automatically.
{$DOMAIN} {
	handle_path /ledger/* {
		reverse_proxy ledger:8080
	}

	handle_path /fx/* {
		reverse_proxy fx:8081
	}

	handle {
		root * /srv/console
		file_server
	}
}
